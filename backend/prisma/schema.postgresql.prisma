datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  STORE_OWNER
  STORE_MANAGER
  STORE_STAFF
  CUSTOMER
  TECHNICIAN
}

enum StoreStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  REJECTED
}

enum DeviceStatus {
  MANUFACTURED
  UNCLAIMED
  CLAIMED
  ASSIGNED
  ACTIVE
  DISABLED
  MAINTENANCE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
  REJECTED
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  fullName        String
  phone           String?
  role            Role             @default(CUSTOMER)
  isActive        Boolean          @default(true)
  storeId         String?
  store           Store?           @relation(fields: [storeId], references: [id])
  customerProfile CustomerProfile?
  auditLogs       AuditLog[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Store {
  id              String            @id @default(uuid())
  name            String
  code            String            @unique
  ownerName       String
  phone           String
  email           String
  address         String
  status          StoreStatus       @default(PENDING_APPROVAL)
  rejectionReason String?
  approvedAt      DateTime?
  users           User[]
  products        Product[]
  devices         Device[]
  customers       CustomerProfile[]
  orders          Order[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model CustomerProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId         String
  store           Store     @relation(fields: [storeId], references: [id])
  apartment       String?
  building        String?
  floor           String?
  room            String?
  deliveryAddress String
  phone           String
  devices         Device[]
  orders          Order[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Product {
  id            String                @id @default(uuid())
  storeId       String
  store         Store                 @relation(fields: [storeId], references: [id])
  name          String
  brand         String
  sku           String
  category      String
  unit          String
  price         Decimal               @db.Decimal(12, 2)
  stock         Int                   @default(0)
  reservedStock Int                   @default(0)
  minStockAlert Int                   @default(5)
  imageUrl      String?
  isActive      Boolean               @default(true)
  deviceConfigs DeviceConfiguration[]
  orderItems    OrderItem[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([storeId, sku])
}

model Device {
  id              String               @id @default(uuid())
  deviceId        String               @unique
  serialNumber    String               @unique
  deviceSecret    String
  claimCode       String
  qrPayload       String               @unique
  firmwareVersion String               @default("1.0.0")
  hardwareModel   String               @default("ESP32-WROOM-32E")
  status          DeviceStatus         @default(UNCLAIMED)
  storeId         String?
  store           Store?               @relation(fields: [storeId], references: [id])
  customerId      String?
  customer        CustomerProfile?     @relation(fields: [customerId], references: [id])
  batteryLevel    Int                  @default(100)
  wifiRSSI        Int                  @default(-50)
  lastSeenAt      DateTime?
  configuration   DeviceConfiguration?
  events          DeviceEvent[]
  telemetries     DeviceTelemetry[]
  orders          Order[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model DeviceConfiguration {
  id                    String   @id @default(uuid())
  deviceId              String   @unique
  device                Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  customName            String
  productId             String
  product               Product  @relation(fields: [productId], references: [id])
  defaultQuantity       Int      @default(1)
  allowCustomerQuantity Boolean  @default(false)
  allowCustomerProduct  Boolean  @default(false)
  quickOrderDirect      Boolean  @default(true)
  cancelWindowSeconds   Int      @default(60)
  soundEnabled          Boolean  @default(true)
  ledEnabled            Boolean  @default(true)
  version               Int      @default(1)
  updatedByUserId       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model DeviceEvent {
  id           String   @id @default(uuid())
  deviceId     String
  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  eventType    String
  requestId    String   @unique
  batteryLevel Int
  wifiRSSI     Int
  rawPayload   String?
  processed    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model DeviceTelemetry {
  id              String   @id @default(uuid())
  deviceId        String
  device          Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  batteryLevel    Int
  voltageMv       Int
  wifiRSSI        Int
  bootReason      String
  wakeDurationMs  Int
  firmwareVersion String
  createdAt       DateTime @default(now())
}

model Order {
  id                 String           @id @default(uuid())
  orderNumber        String           @unique
  storeId            String
  store              Store            @relation(fields: [storeId], references: [id])
  customerId         String
  customer           CustomerProfile  @relation(fields: [customerId], references: [id])
  deviceId           String?
  device             Device?          @relation(fields: [deviceId], references: [id])
  status             OrderStatus      @default(PENDING)
  totalAmount        Decimal          @db.Decimal(12, 2)
  deliveryAddress    String
  customerPhone      String
  customerName       String
  cancelExpiresAt    DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  items              OrderItem[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  productName String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  totalPrice  Decimal  @db.Decimal(12, 2)
}

model IdempotencyRecord {
  key       String   @id
  deviceId  String
  orderId   String?
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String
  oldValues String?
  newValues String?
  ipAddress String?
  createdAt DateTime @default(now())
}
